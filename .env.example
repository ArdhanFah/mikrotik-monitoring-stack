# Copy to .env and replace every CHANGE_ME value before deployment.
TZ=UTC
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_long_random_password
GRAFANA_DOMAIN=monitoring.example.com

# ZeroTier overlay. The Network ID is the 16-character hexadecimal ID
# shown by ZeroTier Central. The subnet is the managed IP range.
ZEROTIER_NETWORK_ID=0123456789abcdef
ZEROTIER_NETWORK=10.147.20.0/24
MIKROTIK_SNMP_TARGET=10.147.20.1
SNMP_COMMUNITY=CHANGE_ME_snmp_community

# Set to the public DNS name used by the reverse proxy.
TLS_EMAIL=admin@example.com
